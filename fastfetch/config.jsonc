{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "iterm",
        "source": "C:/msys64/home/rosha/.config/fastfetch/images/logo.png",
        "width": 30,
        "height": 15,
        "preserveAspectRatio": true,
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "title",
        "separator",

        {
            "type": "os",
            "key": "OS"
        },

        {
            "type": "host",
            "key": "Host"
        },

        {
            "type": "kernel",
            "key": "Kernel"
        },

        {
            "type": "uptime",
            "key": "Uptime"
        },

        {
            "type": "shell",
            "key": "Shell"
        },

        {
            "type": "terminal",
            "key": "Terminal"
        },

        {
            "type": "cpu",
            "key": "CPU"
        },

        {
            "type": "gpu",
            "key": "GPU"
        },

        {
            "type": "memory",
            "key": "Memory"
        },

        {
            "type": "disk",
            "key": "Disk"
        },

        {
            "type": "command",
            "key": "Node",
            "text": "node --version"
        },

        {
            "type": "command",
            "key": "Git",
            "text": "git --version"
        },

        "break",
        "colors"
    ]
}